rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validAccount(accountType) { return accountType in ['SEM_NUMERO', 'COM_NUMERO']; }
    // Firestore stores 123456; the UI may format it as 123-456.
    function validCode(code) { return code is string && code.matches('^[0-9]{6}$'); }
    function roomPath(roomId) {
      return /databases/$(database)/documents/textConversations/$(roomId);
    }
    function isRoomMember(roomId) {
      return signedIn()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.members is list
        && request.auth.uid in get(roomPath(roomId)).data.members;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && validAccount(request.resource.data.accountType)
        && validCode(request.resource.data.code);
      allow delete: if isOwner(uid);
      match /fcmTokens/{tokenId} { allow read, write: if isOwner(uid); }
      match /contacts/{contactId} { allow read, write: if isOwner(uid); }
    }

    match /contactCodes/{code} {
      allow get: if signedIn() && validCode(code);
      allow list: if false;
      allow create: if signedIn()
        && validCode(code)
        && request.resource.data.code == code
        && request.resource.data.uid == request.auth.uid
        && validAccount(request.resource.data.accountType)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'code', 'accountType', 'tgUsername',
          'avatarData', 'avatarVersion', 'is_adult', 'updatedAt'
        ]);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code == code
        && validAccount(request.resource.data.accountType)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'code', 'accountType', 'tgUsername',
          'avatarData', 'avatarVersion', 'is_adult', 'updatedAt'
        ]);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    match /textConversations/{roomId} {
      allow read: if signedIn()
        && resource.data.members is list
        && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 100
        && request.auth.uid in request.resource.data.members
        && request.resource.data.keys().hasOnly([
          'members', 'updatedAt', 'schema', 'group', 'groupKey', 'groupName'
        ]);
      // Membership-management roles are not yet modeled; an existing member may update the list.
      allow update: if signedIn()
        && resource.data.members is list
        && request.auth.uid in resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 100
        && request.auth.uid in request.resource.data.members
        && request.resource.data.keys().hasOnly([
          'members', 'updatedAt', 'schema', 'group', 'groupKey', 'groupName'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.roomId == roomId
          && request.resource.data.id == messageId
          && request.resource.data.toUids is list
          && request.resource.data.toUids.size() >= 1
          && request.resource.data.toUids.size() <= 100
          && request.resource.data.toUids.hasOnly(get(roomPath(roomId)).data.members)
          && request.resource.data.kind in ['text', 'image', 'video', 'audio', 'gif', 'file', 'deleted'];
        allow update: if isRoomMember(roomId) && (
          resource.data.fromUid == request.auth.uid
          || (request.auth.uid in resource.data.toUids
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredBy', 'readBy']))
        );
        allow delete: if isRoomMember(roomId)
          && (resource.data.fromUid == request.auth.uid || request.auth.uid in resource.data.toUids);
      }
    }

    match /messageInbox/{uid}/items/{itemId} {
      allow read, delete: if isOwner(uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid == uid;
      allow update: if isOwner(uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
