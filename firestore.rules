rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()      { return request.auth != null; }
    function isOwner(uid)    { return signedIn() && request.auth.uid == uid; }
    function validAccount(t) { return t in ['SEM_NUMERO', 'COM_NUMERO']; }
    function validCode(c)    { return c.matches('^[0-9]{3}-[0-9]{3}$'); }

    // ---------------------------------------------------------------
    // PERFIL PRIVADO: só o dono lê/escreve (e-mail interno, tgUserId, token...)
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && validAccount(request.resource.data.accountType)
        && validCode(request.resource.data.code);
      allow delete: if isOwner(uid);

      match /fcmTokens/{tokenId} { allow read, write: if isOwner(uid); }
      match /contacts/{contactId} { allow read, write: if isOwner(uid); }
    }

    // ---------------------------------------------------------------
    // DIRETÓRIO PÚBLICO POR CÓDIGO DE 6 DÍGITOS (123-456)
    // O documento contém SOMENTE dados públicos. Regras do Firestore não
    // filtram campos na leitura; por isso nada sensível é gravado aqui
    // (sem telefone, sem tgUserId, sem senha/PIN).
    //   Campos: uid, email, name, code, accountType, tgUsername, fcmToken,
    //           avatarData, is_adult, updatedAt
    // Busca por código = get() direto no documento (não há listagem).
    // ---------------------------------------------------------------
    match /contactCodes/{code} {
      allow get: if signedIn() && validCode(code);
      allow list: if false;
      allow create: if signedIn() && validCode(code)
        && request.resource.data.uid == request.auth.uid
        && validAccount(request.resource.data.accountType)
        && request.resource.data.keys().hasOnly(['uid','email','name','code','accountType','tgUsername','fcmToken','avatarData','avatarVersion','is_adult','updatedAt']);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && validAccount(request.resource.data.accountType)
        && request.resource.data.keys().hasOnly(['uid','email','name','code','accountType','tgUsername','fcmToken','avatarData','avatarVersion','is_adult','updatedAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // PRESENÇA (anel verde/amarelo)
    // ---------------------------------------------------------------
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    // ---------------------------------------------------------------
    // FILA TEMPORÁRIA DE TRANSPORTE (Cenário 1: textos + metadados de mídia)
    // O destinatário grava localmente e APAGA o documento.
    // ---------------------------------------------------------------
    match /textConversations/{room}/messages/{id} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || request.auth.uid in resource.data.toUids);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.kind in ['text','image','video','audio','gif','file','deleted'];
      // autor pode apagar-para-todos; destinatários podem marcar entregue/lida
      allow update: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        (request.auth.uid in resource.data.toUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredBy','readBy'])));
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || request.auth.uid in resource.data.toUids);
    }

    // Caixa de entrada por destinatário (acorda o app / sincroniza)
    match /messageInbox/{uid}/items/{itemId} {
      allow read, delete: if isOwner(uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if isOwner(uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
